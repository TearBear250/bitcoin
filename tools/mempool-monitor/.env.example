BITCOIND_RPC_URL=http://127.0.0.1:18443/   # regtest RPC default port is 18443
BITCOIND_RPC_USER=youruser
BITCOIND_RPC_PASS=yourstrongpassword
POLL_INTERVAL=5
HTTP_PORT=8080
# HTTP_BIND defaults to 127.0.0.1 (loopback). Set to 0.0.0.0 only behind a firewall/proxy.
HTTP_BIND=127.0.0.1
MAX_TX_LOOKUP=50
